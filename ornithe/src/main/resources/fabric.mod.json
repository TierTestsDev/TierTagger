{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "Tier Tagger",
  "description": "Shows PvP tiers from Tier Tests, MCTiers, PvPTiers, SubTiers and MCPVP in nametags and the tab list.",
  "authors": ["Blue_Bed", "MrDrak", "xFlxme"],
  "contact": {
    "homepage": "https://modrinth.com/mod/tiertests",
    "sources": "https://github.com/TierTestsDev/TierTagger",
    "issues": "https://github.com/TierTestsDev/TierTagger/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/tiertag/icon.png",
  "environment": "client",
  "entrypoints": {
    "client-init": ["com.tiertests.tiertagger.ornithe.TierTaggerOrnithe"]
  },
  "mixins": ["tiertag.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18",
    "minecraft": "1.8.9",
    "osl-entrypoints": ">=0.6.0",
    "osl-keybinds": ">=0.3.0",
    "osl-lifecycle-events": ">=0.6.0"
  }
}
